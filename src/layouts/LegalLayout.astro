---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  lastUpdated?: string;
}

const { title, description, lastUpdated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="container legal">
    <header class="legal-head">
      <h1>{title}</h1>
      {lastUpdated && <p class="micro-label">Last updated {lastUpdated}</p>}
    </header>
    <div class="hx-card legal-card">
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .legal {
    padding-block: clamp(40px, 6vw, 72px) clamp(64px, 8vw, 112px);
  }

  .legal-head {
    display: grid;
    gap: 12px;
    max-width: 760px;
    margin: 0 auto 32px;
  }

  .legal-head h1 {
    font-size: clamp(36px, 5vw, 56px);
  }

  .legal-card {
    max-width: 840px;
    margin-inline: auto;
    padding: clamp(24px, 4vw, 40px);
  }

  .legal-card .prose {
    margin-inline: auto;
  }

  .legal-card :global(.prose > :first-child) {
    margin-top: 0;
  }
</style>
