---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="container not-found">
    <p class="micro-label">404</p>
    <h1>This page skipped leg day.</h1>
    <p class="lead">The page you are looking for doesn't exist or has moved.</p>
    <a class="hx-btn hx-btn--primary" href="/">Back to home <Icon name="arrow_forward_rounded" /></a>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    justify-items: center;
    gap: 20px;
    padding-block: clamp(80px, 14vw, 160px);
    text-align: center;
  }
</style>
