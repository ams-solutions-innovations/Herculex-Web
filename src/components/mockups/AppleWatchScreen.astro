---
// Apple Watch screen views (watchOS 10+):
// 1. set_logger: Active set logging with Digital Crown steppers
// 2. rest_timer: Live rest timer with haptic countdown
// 3. active_workout: Full active workout overview (exercises & sets)
// 4. home: watchOS NavigationStack with gradient tiles (WatchHomeView)
// 5. fasting: 16:8 Fasting tracker with stages (WatchFastingView)
import Icon from '../Icon.astro';

interface Props {
  activeScreen?: string;
}

const { activeScreen = 'set_logger' } = Astro.props;
---

<div class="apple-screen-container">
  <!-- ── 1. SET LOGGER VIEW (WatchSetView) ── -->
  <div class:list={['apple-view', 'view-set_logger', { active: activeScreen === 'set_logger' }]}>
    <div class="apple-nav-header">
      <span class="apple-back-btn">
        <Icon name="chevron_left_rounded" size={16} />
        <span>Workout</span>
      </span>
      <span class="apple-set-indicator">Set 3/4</span>
    </div>

    <!-- Active Exercise Title -->
    <div class="apple-ex-badge">
      <img src="/images/exercises/barbell-bench-press.webp" alt="" class="apple-ex-icon" width="22" height="22" />
      <div class="apple-ex-titles">
        <span class="apple-ex-name">Barbell Bench Press</span>
        <span class="apple-ex-target">Target: 82.5 kg × 6 · RPE 8.5</span>
      </div>
    </div>

    <!-- Crown Stepper Inputs (Weight & Reps) -->
    <div class="apple-crown-grid">
      <!-- Weight Picker -->
      <div class="apple-crown-box">
        <span class="apple-crown-label">Weight · kg</span>
        <div class="apple-crown-value-row">
          <span class="apple-val-number js-apple-weight">82.5</span>
        </div>
        <div class="apple-crown-btns">
          <button type="button" class="apple-btn-step js-step-weight-minus" aria-label="Decrease weight">−0.5</button>
          <button type="button" class="apple-btn-step js-step-weight-plus" aria-label="Increase weight">+0.5</button>
        </div>
      </div>

      <!-- Reps Picker -->
      <div class="apple-crown-box">
        <span class="apple-crown-label">Repetitions</span>
        <div class="apple-crown-value-row">
          <span class="apple-val-number js-apple-reps">6</span>
        </div>
        <div class="apple-crown-btns">
          <button type="button" class="apple-btn-step js-step-reps-minus" aria-label="Decrease reps">−1</button>
          <button type="button" class="apple-btn-step js-step-reps-plus" aria-label="Increase reps">+1</button>
        </div>
      </div>
    </div>

    <!-- Set Type & RPE Row -->
    <div class="apple-meta-chips">
      <span class="apple-chip apple-chip--cyan">STANDARD</span>
      <span class="apple-chip apple-chip--purple">RPE 8.5</span>
      <span class="apple-history-tag">Prev: 80×8 ✓</span>
    </div>

    <!-- Complete Set Button (WatchViews.swift line 377: Button("Complete set").tint(.green)) -->
    <button type="button" class="apple-btn-complete js-apple-complete-btn">
      <Icon name="check_circle_rounded" size={17} />
      <span>Complete set</span>
    </button>
  </div>

  <!-- ── 2. REST TIMER VIEW (WatchRestView) ── -->
  <div class:list={['apple-view', 'view-rest_timer', { active: activeScreen === 'rest_timer' }]}>
    <div class="apple-nav-header apple-nav-header--center">
      <span class="apple-rest-title">Rest Timer</span>
      <span class="apple-rest-hr">♥ 138 bpm</span>
    </div>

    <!-- Center Ring & Countdown -->
    <div class="apple-rest-ring-wrap">
      <svg class="apple-rest-svg" viewBox="0 0 140 140">
        <circle cx="70" cy="70" r="58" fill="none" stroke="rgba(255, 255, 255, 0.1)" stroke-width="7" />
        <circle
          class="apple-rest-circle js-rest-circle"
          cx="70" cy="70" r="58"
          fill="none"
          stroke="#30d158"
          stroke-width="7"
          stroke-linecap="round"
          stroke-dasharray="364.4"
          stroke-dashoffset="120"
          transform="rotate(-90 70 70)"
        />
      </svg>
      <div class="apple-rest-center-copy">
        <span class="apple-rest-time js-rest-countdown">01:15</span>
        <span class="apple-rest-unit">REMAINING</span>
      </div>
    </div>

    <div class="apple-rest-next-box">
      <span class="apple-next-tag">NEXT SET</span>
      <span class="apple-next-text">Set 4 · 82.5 kg × 6 reps</span>
    </div>

    <div class="apple-rest-actions">
      <button type="button" class="apple-btn-sec js-rest-add30">+30s</button>
      <button type="button" class="apple-btn-prim js-rest-skip">Skip Rest</button>
    </div>
  </div>

  <!-- ── 3. ACTIVE WORKOUT VIEW (WatchActiveWorkoutView) ── -->
  <div class:list={['apple-view', 'view-active_workout', { active: activeScreen === 'active_workout' }]}>
    <div class="apple-workout-header">
      <span class="apple-workout-timer">18:42</span>
      <span class="apple-workout-vitals">♥ 142 bpm · 328 kcal</span>
    </div>

    <div class="apple-workout-list">
      <!-- Exercise 1 (Active) -->
      <div class="apple-workout-row apple-workout-row--active">
        <img src="/images/exercises/barbell-bench-press.webp" alt="" class="apple-row-img" width="28" height="28" />
        <div class="apple-row-info">
          <p class="apple-row-name">Barbell Bench Press</p>
          <p class="apple-row-sub">2/3 sets · Last: 80 kg × 8</p>
        </div>
        <span class="apple-row-tag">Active</span>
      </div>

      <!-- Exercise 2 (Upcoming) -->
      <div class="apple-workout-row">
        <img src="/images/exercises/barbell-back-squat.webp" alt="" class="apple-row-img" width="28" height="28" />
        <div class="apple-row-info">
          <p class="apple-row-name">Barbell Back Squat</p>
          <p class="apple-row-sub">0/3 sets · Target: 100 kg</p>
        </div>
        <Icon name="chevron_right_rounded" size={16} class="apple-row-chevron" />
      </div>
    </div>

    <div class="apple-workout-footer">
      <button type="button" class="apple-pill-btn apple-pill-btn--green">
        Finish workout
      </button>
    </div>
  </div>

  <!-- ── 4. HOME VIEW (WatchHomeView with gradient tiles) ── -->
  <div class:list={['apple-view', 'view-home', { active: activeScreen === 'home' }]}>
    <div class="apple-home-top">
      <span class="apple-home-brand">Herculex</span>
      <span class="apple-sync-status">
        <Icon name="sync_rounded" size={11} class="apple-sync-spin" /> Synced just now
      </span>
    </div>

    <div class="apple-tiles-stack">
      <!-- Tile 1: Active Workout -->
      <div class="apple-tile apple-tile--green">
        <Icon name="fitness_center_rounded" size={16} />
        <div class="apple-tile-text">
          <span class="apple-tile-title">Active workout</span>
          <span class="apple-tile-sub">18:42 · Full Body A</span>
        </div>
      </div>

      <!-- Tile 2: Workouts -->
      <div class="apple-tile apple-tile--blue">
        <Icon name="calendar_month_rounded" size={16} />
        <div class="apple-tile-text">
          <span class="apple-tile-title">Workouts</span>
          <span class="apple-tile-sub">3 scheduled routines</span>
        </div>
      </div>

      <!-- Tile 3: Nutrition -->
      <div class="apple-tile apple-tile--orange">
        <Icon name="restaurant_rounded" size={16} />
        <div class="apple-tile-text">
          <span class="apple-tile-title">Nutrition</span>
          <span class="apple-tile-sub">1,840 / 2,400 kcal</span>
        </div>
      </div>

      <!-- Tile 4: Fasting -->
      <div class="apple-tile apple-tile--purple">
        <Icon name="timelapse" size={16} />
        <div class="apple-tile-text">
          <span class="apple-tile-title">Fasting</span>
          <span class="apple-tile-sub">14h 22m · 16:8 Fast</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ── 5. FASTING VIEW (WatchFastingView) ── -->
  <div class:list={['apple-view', 'view-fasting', { active: activeScreen === 'fasting' }]}>
    <div class="apple-nav-header apple-nav-header--center">
      <span class="apple-fast-badge">16:8 FASTING</span>
    </div>

    <div class="apple-fast-hero">
      <span class="apple-fast-timer js-fast-elapsed">14:22:38</span>
      <span class="apple-fast-sub">Goal · 16h 00m (01:38 left)</span>
    </div>

    <div class="apple-fast-card">
      <span class="apple-stage-title">Optimal Fat Burning</span>
      <p class="apple-stage-desc">
        Golden standard of intermittent fasting! Fat oxidation reaches peak metabolic efficiency.
      </p>
    </div>

    <div class="apple-fast-actions">
      <button type="button" class="apple-btn-fast-stop js-btn-apple-fast">End Fast</button>
    </div>
  </div>
</div>

<style>
  .apple-screen-container {
    position: relative;
    width: 100%;
    height: 100%;
    color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', var(--hx-font-body), sans-serif;
    user-select: none;
  }

  .apple-view {
    display: none;
    flex-direction: column;
    height: 100%;
    justify-content: space-between;
    animation: apple-appear 0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .apple-view.active {
    display: flex;
  }

  @keyframes apple-appear {
    from { opacity: 0; transform: scale(0.97); }
    to { opacity: 1; transform: scale(1); }
  }

  /* ── 1. Set Logger ── */
  .apple-nav-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    font-weight: 600;
    color: #22d3ee;
    line-height: 1;
    margin-bottom: 4px;
  }

  .apple-nav-header--center {
    justify-content: center;
    gap: 8px;
  }

  .apple-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    color: #22d3ee;
  }

  .apple-set-indicator {
    color: #94a3b8;
    font-size: 10px;
    font-weight: 700;
  }

  .apple-ex-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #141720;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 5px 8px;
    margin-bottom: 6px;
  }

  .apple-ex-icon {
    border-radius: 5px;
    background: #1e2430;
    object-fit: cover;
    flex-shrink: 0;
  }

  .apple-ex-titles {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .apple-ex-name {
    font-size: 11.5px;
    font-weight: 700;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .apple-ex-target {
    font-size: 9px;
    color: #94a3b8;
  }

  .apple-crown-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    margin-bottom: 6px;
  }

  .apple-crown-box {
    background: #151922;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 6px 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .apple-crown-label {
    font-size: 9px;
    font-weight: 600;
    color: #8b9bb4;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  .apple-crown-value-row {
    margin: 2px 0 4px;
  }

  .apple-val-number {
    font-size: 22px;
    font-weight: 800;
    color: #ffffff;
    font-family: var(--hx-font-mono, monospace);
    letter-spacing: -0.5px;
    line-height: 1;
  }

  .apple-crown-btns {
    display: flex;
    gap: 4px;
    width: 100%;
  }

  .apple-btn-step {
    flex: 1;
    height: 22px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.1s ease, transform 0.1s ease;
    padding: 0;
  }

  .apple-btn-step:active {
    background: rgba(255, 255, 255, 0.25);
    transform: scale(0.95);
  }

  .apple-meta-chips {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    margin-bottom: 6px;
  }

  .apple-chip {
    font-size: 8px;
    font-weight: 800;
    padding: 2px 5px;
    border-radius: 5px;
    letter-spacing: 0.3px;
  }

  .apple-chip--cyan {
    background: rgba(34, 211, 238, 0.16);
    color: #22d3ee;
  }

  .apple-chip--purple {
    background: rgba(192, 132, 252, 0.16);
    color: #c084fc;
  }

  .apple-history-tag {
    font-size: 8.5px;
    color: #94a3b8;
    margin-left: 2px;
  }

  .apple-btn-complete {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    height: 36px;
    border-radius: 12px;
    background: linear-gradient(135deg, #10b981, #059669);
    border: none;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
    transition: transform 0.1s ease, filter 0.1s ease;
  }

  .apple-btn-complete:active {
    transform: scale(0.97);
    filter: brightness(1.15);
  }

  /* ── 2. Rest Timer ── */
  .apple-rest-title {
    font-size: 11px;
    font-weight: 700;
    color: #30d158;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .apple-rest-hr {
    font-size: 10px;
    font-weight: 600;
    color: #ff453a;
  }

  .apple-rest-ring-wrap {
    position: relative;
    width: 130px;
    height: 130px;
    margin: 4px auto 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .apple-rest-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .apple-rest-center-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }

  .apple-rest-time {
    font-size: 34px;
    font-weight: 800;
    color: #ffffff;
    font-family: var(--hx-font-mono, monospace);
    letter-spacing: -1.5px;
  }

  .apple-rest-unit {
    font-size: 8px;
    font-weight: 700;
    color: #64748b;
    letter-spacing: 0.6px;
    margin-top: 2px;
  }

  .apple-rest-next-box {
    text-align: center;
    margin: 2px 0 6px;
    line-height: 1.2;
  }

  .apple-next-tag {
    font-size: 8px;
    font-weight: 800;
    color: #64748b;
    letter-spacing: 0.5px;
  }

  .apple-next-text {
    display: block;
    font-size: 11.5px;
    font-weight: 700;
    color: #ffffff;
  }

  .apple-rest-actions {
    display: flex;
    gap: 8px;
  }

  .apple-btn-sec {
    flex: 1;
    height: 32px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.12);
    border: none;
    color: #ffffff;
    font-size: 11.5px;
    font-weight: 700;
    cursor: pointer;
  }

  .apple-btn-prim {
    flex: 2;
    height: 32px;
    border-radius: 12px;
    background: #30d158;
    border: none;
    color: #032014;
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
  }

  /* ── 3. Active Workout ── */
  .apple-workout-header {
    text-align: center;
    margin-bottom: 6px;
  }

  .apple-workout-timer {
    display: block;
    font-size: 24px;
    font-weight: 800;
    color: #22d3ee;
    font-family: var(--hx-font-mono, monospace);
    line-height: 1;
  }

  .apple-workout-vitals {
    font-size: 10px;
    color: #94a3b8;
    margin-top: 2px;
    display: block;
  }

  .apple-workout-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .apple-workout-row {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #141720;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 8px 10px;
  }

  .apple-workout-row--active {
    border-color: rgba(34, 211, 238, 0.35);
    background: #161c28;
  }

  .apple-row-img {
    border-radius: 6px;
    background: #1e2430;
    flex-shrink: 0;
  }

  .apple-row-info {
    flex: 1;
    min-width: 0;
    line-height: 1.2;
  }

  .apple-row-name {
    font-size: 12px;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .apple-row-sub {
    font-size: 9.5px;
    color: #94a3b8;
    margin: 0;
  }

  .apple-row-tag {
    font-size: 9px;
    font-weight: 800;
    color: #22d3ee;
    background: rgba(34, 211, 238, 0.16);
    padding: 2px 5px;
    border-radius: 5px;
  }

  .apple-row-chevron {
    color: #64748b;
  }

  .apple-workout-footer {
    margin-top: 6px;
  }

  .apple-pill-btn {
    width: 100%;
    height: 34px;
    border-radius: 14px;
    border: none;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
  }

  .apple-pill-btn--green {
    background: linear-gradient(135deg, #10b981, #059669);
    color: #ffffff;
  }

  /* ── 4. Home (WatchHomeView) ── */
  .apple-home-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }

  .apple-home-brand {
    font-size: 14px;
    font-weight: 800;
    color: #ffffff;
  }

  .apple-sync-status {
    font-size: 9.5px;
    color: #94a3b8;
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }

  .apple-tiles-stack {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .apple-tile {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-radius: 18px;
    color: #ffffff;
  }

  .apple-tile--green {
    background: linear-gradient(135deg, #15803d, #166534);
  }

  .apple-tile--blue {
    background: linear-gradient(135deg, #1d4ed8, #1e40af);
  }

  .apple-tile--orange {
    background: linear-gradient(135deg, #c2410c, #9a3412);
  }

  .apple-tile--purple {
    background: linear-gradient(135deg, #7e22ce, #6b21a8);
  }

  .apple-tile-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .apple-tile-title {
    font-size: 12px;
    font-weight: 700;
  }

  .apple-tile-sub {
    font-size: 9.5px;
    opacity: 0.85;
  }

  /* ── 5. Fasting (WatchFastingView) ── */
  .apple-fast-badge {
    font-size: 9.5px;
    font-weight: 800;
    color: #c084fc;
    letter-spacing: 0.5px;
  }

  .apple-fast-hero {
    text-align: center;
    margin: 6px 0;
  }

  .apple-fast-timer {
    font-size: 28px;
    font-weight: 800;
    color: #d8b4fe;
    font-family: var(--hx-font-mono, monospace);
    letter-spacing: -1px;
    display: block;
  }

  .apple-fast-sub {
    font-size: 9.5px;
    color: #94a3b8;
  }

  .apple-fast-card {
    background: #191424;
    border: 1px solid rgba(192, 132, 252, 0.2);
    border-radius: 12px;
    padding: 8px 10px;
    margin-bottom: 8px;
  }

  .apple-stage-title {
    font-size: 11px;
    font-weight: 700;
    color: #c084fc;
    display: block;
    margin-bottom: 2px;
  }

  .apple-stage-desc {
    font-size: 9px;
    color: #cbd5e1;
    line-height: 1.35;
    margin: 0;
  }

  .apple-btn-fast-stop {
    width: 100%;
    height: 32px;
    border-radius: 12px;
    background: #ea580c;
    border: none;
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
  }
</style>
