---
// A 390 × 844 phone (1 CSS px = 1 Flutter dp) so the screens inside use the
// app's real measurements. Scale it from outside with `zoom`.
import Icon from '../Icon.astro';

interface Props {
  class?: string;
  label: string;
}

const { class: className, label } = Astro.props;
---

<figure class:list={['phone', className]} role="img" aria-label={label}>
  <div class="screen">
    <div class="status" aria-hidden="true">
      <span class="time">9:41</span>
      <span class="island"></span>
      <span class="status-icons">
        <Icon name="signal_cellular_alt_rounded" size={17} />
        <Icon name="wifi_rounded" size={17} />
        <Icon name="battery_full_rounded" size={17} class="battery" />
      </span>
    </div>
    <div class="content" aria-hidden="true">
      <slot />
    </div>
    <span class="home-indicator" aria-hidden="true"></span>
  </div>
</figure>

<style>
  .phone {
    position: relative;
    width: 414px;
    height: 868px;
    padding: 12px;
    border-radius: 64px;
    background: #05070b;
    box-shadow:
      inset 0 0 0 2px #2a3140,
      inset 0 0 0 5px #05070b,
      0 40px 80px -20px rgb(0 0 0 / 0.55);
    flex: none;
    user-select: none;
  }

  .screen {
    position: relative;
    width: 390px;
    height: 844px;
    overflow: hidden;
    border-radius: 52px;
    background: linear-gradient(to bottom right, var(--hx-gradient-top), var(--hx-gradient-mid), var(--hx-gradient-bottom));
    color: var(--hx-on-surface-variant);
    font-family: var(--hx-font-body);
    font-size: 15px;
    line-height: normal;
    letter-spacing: -0.1px;
  }

  .status {
    position: absolute;
    inset: 0 0 auto;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 47px;
    padding: 4px 30px 0 44px;
    color: var(--hx-on-surface);
  }

  .time {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.2px;
  }

  .island {
    position: absolute;
    left: 50%;
    top: 11px;
    width: 122px;
    height: 35px;
    border-radius: 20px;
    background: #000;
    transform: translateX(-50%);
  }

  .status-icons {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .status-icons :global(.battery) {
    transform: rotate(90deg);
  }

  .content {
    position: absolute;
    inset: 47px 0 0;
  }

  .home-indicator {
    position: absolute;
    left: 50%;
    bottom: 8px;
    z-index: 3;
    width: 134px;
    height: 5px;
    border-radius: 3px;
    background: var(--hx-on-surface);
    transform: translateX(-50%);
  }
</style>
