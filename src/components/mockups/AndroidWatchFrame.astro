---
// A 360 × 360 circular Wear OS watch frame (Galaxy Watch / Pixel Watch style)
// with titanium chassis, dual side buttons, circular screen, and the iconic
// Herculex SetBezel segmented arc around the display.
interface Props {
  class?: string;
  label?: string;
}

const { class: className, label = 'Herculex on Android Watch (Wear OS)' } = Astro.props;
---

<figure class:list={['android-watch-frame', className]} role="img" aria-label={label}>
  <!-- Top strap hint -->
  <div class="strap strap--top" aria-hidden="true">
    <div class="strap-groove"></div>
  </div>

  <!-- Circular hardware case -->
  <div class="case">
    <!-- Physical Buttons on right -->
    <div class="btn btn--top" aria-hidden="true"></div>
    <div class="btn btn--bottom" aria-hidden="true"></div>

    <!-- Outer tachymeter/bezel rim with subtle tick marks -->
    <div class="bezel-rim" aria-hidden="true"></div>

    <!-- Circular OLED Screen -->
    <div class="screen">
      <!-- Curved glass reflection highlight -->
      <div class="glass-glare" aria-hidden="true"></div>

      <!-- Herculex SetBezel: Segmented circular SVG ring around display -->
      <!-- Slot 1 (warm-up): amber (done) -->
      <!-- Slot 2 (working): blue/cyan (done) -->
      <!-- Slot 3 (working): blue/cyan (active, pulsing) -->
      <!-- Slot 4 (working): dark blue track (pending) -->
      <svg class="set-bezel" viewBox="0 0 310 310" aria-hidden="true">
        <!-- Track Background -->
        <circle cx="155" cy="155" r="148" fill="none" stroke="#121824" stroke-width="6" />

        <!-- Segment 1: Warmup (Done, Amber) - from -90deg to -5deg -->
        <circle
          cx="155" cy="155" r="148"
          fill="none"
          stroke="#ffa726"
          stroke-width="7"
          stroke-linecap="round"
          stroke-dasharray="210 900"
          stroke-dashoffset="0"
          transform="rotate(-90 155 155)"
        />

        <!-- Segment 2: Working Set 1 (Done, Cyan) - from 0deg to 85deg -->
        <circle
          cx="155" cy="155" r="148"
          fill="none"
          stroke="#26c6da"
          stroke-width="7"
          stroke-linecap="round"
          stroke-dasharray="210 900"
          stroke-dashoffset="-232"
          transform="rotate(-90 155 155)"
        />

        <!-- Segment 3: Working Set 2 (Current Active, Pulsing Cyan) - from 90deg to 175deg -->
        <circle
          class="bezel-active"
          cx="155" cy="155" r="148"
          fill="none"
          stroke="#00e5ff"
          stroke-width="7"
          stroke-linecap="round"
          stroke-dasharray="210 900"
          stroke-dashoffset="-464"
          transform="rotate(-90 155 155)"
        />

        <!-- Segment 4: Working Set 3 (Pending, Dark Track) - from 180deg to 265deg -->
        <circle
          cx="155" cy="155" r="148"
          fill="none"
          stroke="#1b2a40"
          stroke-width="7"
          stroke-linecap="round"
          stroke-dasharray="210 900"
          stroke-dashoffset="-696"
          transform="rotate(-90 155 155)"
        />
      </svg>

      <!-- Wear OS Top Status -->
      <div class="status-bar" aria-hidden="true">
        <span class="status-time">9:41</span>
        <div class="status-vitals">
          <span class="vital-item vital-heart">
            <span class="heart-icon">♥</span>
            <span class="vital-val">142</span>
          </span>
          <span class="vital-item vital-flame">
            <span class="flame-icon">🔥</span>
            <span class="vital-val">328</span>
          </span>
        </div>
      </div>

      <!-- Circular Screen Content -->
      <div class="content">
        <slot />
      </div>
    </div>
  </div>

  <!-- Bottom strap hint -->
  <div class="strap strap--bottom" aria-hidden="true">
    <div class="strap-groove"></div>
  </div>
</figure>

<style>
  .android-watch-frame {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    margin: 0 auto;
    user-select: none;
    filter: drop-shadow(0 30px 50px rgba(0, 0, 0, 0.7));
  }

  /* Straps */
  .strap {
    position: relative;
    width: 180px;
    height: 44px;
    background: linear-gradient(to right, #11141b, #1d222c 30%, #242a36 50%, #1d222c 70%, #11141b);
    display: flex;
    justify-content: center;
    z-index: 1;
    overflow: hidden;
  }

  .strap--top {
    margin-bottom: -16px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    mask-image: linear-gradient(to top, rgba(0, 0, 0, 1) 60%, rgba(0, 0, 0, 0));
  }

  .strap--bottom {
    margin-top: -16px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1) 60%, rgba(0, 0, 0, 0));
  }

  .strap-groove {
    width: 80px;
    height: 8px;
    background: #0d0f14;
    border-radius: 4px;
    opacity: 0.5;
    margin: 6px auto;
  }

  /* Case chassis (Circular Titanium / Obsidian) */
  .case {
    position: relative;
    width: 360px;
    height: 360px;
    padding: 18px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #2f3544 0%, #1c202a 50%, #0d0f14 100%);
    box-shadow:
      inset 0 0 0 2px rgba(255, 255, 255, 0.16),
      inset 0 2px 5px rgba(255, 255, 255, 0.22),
      inset 0 -3px 8px rgba(0, 0, 0, 0.7),
      0 0 0 2px #0a0c10,
      0 24px 44px rgba(0, 0, 0, 0.85);
    z-index: 2;
  }

  /* Buttons */
  .btn {
    position: absolute;
    width: 8px;
    height: 44px;
    border-radius: 4px;
    background: linear-gradient(to right, #1d212a, #323847);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.25),
      2px 2px 5px rgba(0, 0, 0, 0.6);
  }

  .btn--top {
    right: 2px;
    top: 74px;
    transform: rotate(26deg);
  }

  .btn--bottom {
    right: 2px;
    bottom: 74px;
    transform: rotate(-26deg);
  }

  /* Bezel rim */
  .bezel-rim {
    position: absolute;
    inset: 12px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.08);
    pointer-events: none;
  }

  /* Screen */
  .screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #000000;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.05);
  }

  /* Glass glare */
  .glass-glare {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 140px;
    background: radial-gradient(ellipse at 50% 0%, rgba(255, 255, 255, 0.09) 0%, transparent 70%);
    pointer-events: none;
    z-index: 10;
  }

  /* SetBezel circular SVG */
  .set-bezel {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 4;
  }

  .bezel-active {
    animation: hx-bezel-pulse 1.8s ease-in-out infinite alternate;
  }

  @keyframes hx-bezel-pulse {
    0% { opacity: 0.55; stroke-width: 7; }
    100% { opacity: 1; stroke-width: 8.5; filter: drop-shadow(0 0 4px #00e5ff); }
  }

  /* Status Bar */
  .status-bar {
    position: relative;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 18px;
    width: 100%;
    line-height: 1;
  }

  .status-time {
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.2px;
    margin-bottom: 3px;
  }

  .status-vitals {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .vital-item {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 11px;
    font-weight: 600;
    color: #cbd5e1;
  }

  .vital-heart .heart-icon {
    color: #ff453a;
    font-size: 11px;
    animation: hx-heartbeat 1.1s ease-in-out infinite;
  }

  .vital-flame .flame-icon {
    color: #ffa726;
    font-size: 11px;
  }

  @keyframes hx-heartbeat {
    0%, 100% { transform: scale(1); }
    15% { transform: scale(1.22); }
    30% { transform: scale(1); }
    45% { transform: scale(1.15); }
  }

  /* Content */
  .content {
    position: relative;
    z-index: 5;
    flex: 1;
    width: 100%;
    padding: 0 28px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--hx-on-surface);
    font-family: -apple-system, BlinkMacSystemFont, 'Roboto', var(--hx-font-body), sans-serif;
  }
</style>
