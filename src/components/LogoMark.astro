---
// The Herculex "H" dumbbell, traced from assets/images/app_icon_foreground.png
// (1254 × 1254 canvas). The left half is drawn once and mirrored.
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className } = Astro.props;
const half = `
  <rect x="200" y="515" width="48" height="226" rx="20"/>
  <rect x="261" y="453" width="83" height="349" rx="34"/>
  <path d="M362 538Q362 525 373 518L510 441V861Q510 881 490 881H382Q362 881 362 861Z"/>
  <path d="M362 428Q362 413 375 406L478 350Q510 334 510 368V410L362 506Z"/>
`;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="190 330 874 566"
  width={size}
  height={Math.round((size * 566) / 874)}
  class={className}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <g set:html={half} />
  <g transform="matrix(-1 0 0 1 1254 0)" set:html={half} />
  <rect x="500" y="575" width="254" height="101" />
</svg>
